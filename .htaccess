# ============================================================
#  Norvexa Logistics — Apache configuration
#  Clean URLs (ЧПУ), security headers, caching & compression
# ============================================================

# ---- Pretty URLs -------------------------------------------
RewriteEngine On
# RewriteBase / must match the sub-folder if the site is not at the domain root.
RewriteBase /

# Force HTTPS (uncomment on production behind a real certificate)
# RewriteCond %{HTTPS} off
# RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Serve real files and directories directly (assets, images, css, js ...)
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else goes through the front controller
RewriteRule ^(.*)$ index.php [QSA,L]

# ---- Default document & error page -------------------------
DirectoryIndex index.php
ErrorDocument 404 /index.php

# ---- Protect sensitive files -------------------------------
<FilesMatch "^(config\.php|composer\.(json|lock)|\.env|.*\.md)$">
    Require all denied
</FilesMatch>

# Disable directory browsing
Options -Indexes

# ---- Security headers --------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ---- GZIP compression --------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# ---- Browser caching for static assets ---------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css              "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/jpeg            "access plus 6 months"
    ExpiresByType image/png             "access plus 6 months"
    ExpiresByType image/svg+xml         "access plus 6 months"
    ExpiresByType image/webp            "access plus 6 months"
    ExpiresByType font/woff2            "access plus 1 year"
</IfModule>
